{
  "paths": {
    "@app/*": ["src/app/*"],
    "@entities/*": ["src/entities/*"],
    "@pages/*": ["src/pages/*"],
    "@shared/*": ["src/shared/*"],
    "@widgets/*": ["src/widgets/*"],
    "@features/*": ["src/features/*"]
  },
  "entry": "src/app/main.tsx",
  "ignore": ["steiger.config.ts", "@feature-sliced/steiger-plugin"],
  "ignoreDependencies": []
}
